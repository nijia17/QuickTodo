<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.QuickTodo">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.QuickTodo"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".AddTaskActivity"
            android:exported="true"
            android:theme="@style/Theme.QuickTodo">
        </activity>

        <activity
            android:name=".AIAnalyzeActivity"
            android:exported="false"
            android:theme="@style/Theme.QuickTodo">
        </activity>

        <activity
            android:name=".StatisticsActivity"
            android:exported="false"
            android:theme="@style/Theme.QuickTodo">
        </activity>

        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:theme="@style/Theme.QuickTodo">
        </activity>

        <activity
            android:name=".QuickAddActivity"
            android:exported="true"
            android:theme="@style/Theme.QuickTodo.Dialog"
            android:launchMode="singleInstance"
            android:excludeFromRecents="true"
            android:taskAffinity="com.example.quicktodo.quickadd"
            android:windowSoftInputMode="adjustResize">
        </activity>

        <receiver
            android:name=".QuickTodoWidget"
            android:exported="true"
            android:permission="android.permission.BIND_APPWIDGET">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE"/>
                <action android:name="android.appwidget.action.APPWIDGET_ENABLED"/>
                <action android:name="android.appwidget.action.APPWIDGET_DISABLED"/>
                <action android:name="android.appwidget.action.APPWIDGET_DELETED"/>
                <action android:name="com.example.quicktodo.TOGGLE_TASK"/>
                <action android:name="com.example.quicktodo.WIDGET_UPDATE"/>
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/todo_widget_info"/>
        </receiver>

        <receiver
            android:name=".AlarmReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.example.quicktodo.ALARM_ACTION"/>
            </intent-filter>
        </receiver>

        <service
            android:name=".TaskWidgetService"
            android:exported="false"
            android:permission="android.permission.BIND_REMOTEVIEWS"/>
    </application>

</manifest>
