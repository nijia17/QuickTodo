<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.QuickTodo" parent="Theme.AppCompat.Light.NoActionBar" />

    <style name="Theme.QuickTodo.Dialog" parent="android:Theme.Material.Light.Dialog.MinWidth">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:backgroundDimEnabled">false</item>
    </style>

    <style name="TimePickerDialogTheme" parent="android:Theme.Material.Light.Dialog">
        <item name="android:colorAccent">#2D2D2D</item>
        <item name="android:colorPrimary">#2D2D2D</item>
        <item name="android:colorPrimaryDark">#2D2D2D</item>
        <item name="android:colorControlActivated">#2D2D2D</item>
        <item name="android:colorControlHighlight">#E0E0E0</item>
        <item name="android:buttonBarPositiveButtonStyle">@style/TimePickerButton</item>
        <item name="android:buttonBarNegativeButtonStyle">@style/TimePickerButton</item>
    </style>

    <style name="TimePickerButton" parent="android:Widget.Material.Button.Borderless">
        <item name="android:textColor">#2D2D2D</item>
    </style>

</resources>
